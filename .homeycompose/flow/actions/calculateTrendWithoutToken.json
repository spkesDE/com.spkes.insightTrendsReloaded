          "id": "60",
          "label": {
            "en": "Hours",
            "de": "Stunden",
            "sv": "Timmar"
          }
        },
        {
          "id": "1440",
          "label": {
            "en": "Days",
            "de": "Tage",
            "sv": "Dagar"
          }
        }
      ]
    },
    {
      "type": "text",
      "name": "label",
      "title": {
        "en": "Label",
        "de": "Label",
        "sv": "Etikett"
